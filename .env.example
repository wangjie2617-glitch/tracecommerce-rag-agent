APP_ENV=development
APP_NAME=TraceCommerce RAG Agent
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# 本地 Python 连接 Docker 中的 PostgreSQL；按自己的端口和账户修改
DATABASE_URL=postgresql+asyncpg://tracecommerce:change-me@localhost:5433/tracecommerce
JWT_SECRET_KEY=change-me-to-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# 本地 Python 连接 Docker 中的 Milvus
MILVUS_URI=http://localhost:19531
MILVUS_TOKEN=
MILVUS_COLLECTION=tracecommerce_chunks_zh_cn
VECTOR_STORE_PROVIDER=milvus

LLM_PROVIDER=openai_compatible
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16

RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

RETRIEVAL_TOP_K=12
RERANK_TOP_K=5
MIN_RETRIEVAL_SCORE=0.35
MIN_EVIDENCE_SCORE=0.45

SHOPIFY_ALLOWED_PREFIXES=https://help.shopify.com/zh-CN/manual/international,https://help.shopify.com/zh-CN/manual/markets,https://help.shopify.com/zh-CN/manual/shipping-and-delivery,https://help.shopify.com/zh-CN/manual/taxes,https://help.shopify.com/zh-CN/manual/fulfillment/managing-orders/returns,https://help.shopify.com/zh-CN/manual/fulfillment/managing-orders/refunding-orders,https://help.shopify.com/zh-CN/manual/fulfillment/setup/order-status-page,https://help.shopify.com/zh-CN/manual/fulfillment/managing-orders/order-status
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; TraceCommerceKnowledgeBot/1.0; +local educational RAG project)
CRAWLER_TIMEOUT_SECONDS=20
CRAWLER_DELAY_SECONDS=1.0
CRAWLER_MAX_PAGES=30
CRAWLER_MAX_DEPTH=2

MAX_UPLOAD_BYTES=10485760
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-running
